#!/bin/sh
# Fake nvidia-smi for ServerLens script tests.
case "$FAKE_MODE" in
  smi-broken) echo "NVIDIA-SMI has failed because it couldn't communicate with the NVIDIA driver."; exit 9;;
esac
for arg in "$@"; do
  case "$arg" in
    --query-gpu=*)
      echo "0, GPU-aaaa-0000, NVIDIA GeForce RTX 4090, 12, 3, 24564, 20263, 4301, 41, 71.20, 450.00, 30"
      echo "1, GPU-aaaa-0001, NVIDIA GeForce RTX 4090, 94, 61, 24564, 2240, 22324, 77, 401.55, 450.00, [N/A]"
      exit 0;;
    --query-compute-apps=*)
      echo "GPU-aaaa-0001, 4242, /usr/bin/python3, 22000"
      echo "GPU-aaaa-0001, 4243, \"python,worker\", 300"
      exit 0;;
  esac
done
exit 2
